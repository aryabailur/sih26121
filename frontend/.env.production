# Committed on purpose (no secrets): read by `next build` on Vercel.
# The hosted API on Render. The browser pings it directly to wake it from sleep (see init() in lib/store.ts);
# all data still goes through the /api/* proxy (NWIS_BACKEND_URL, set in the Vercel project).
NEXT_PUBLIC_NWIS_WAKE_URL=https://nwis-api-4fue.onrender.com
